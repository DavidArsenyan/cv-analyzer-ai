FROM node:22-alpine AS deps

WORKDIR /app

COPY package*.json ./
RUN npm ci

FROM node:22-alpine AS builder

WORKDIR /app

ARG NEXT_PUBLIC_API_URL=
ARG NEXT_PUBLIC_SITE_URL=http://localhost:3000
ARG INTERNAL_API_URL=http://backend:8000
ARG NEXT_PUBLIC_ADSENSE_CLIENT=
ARG NEXT_PUBLIC_ADSENSE_SLOT_TOOLS=
ARG NEXT_PUBLIC_ADSENSE_SLOT_DOCUMENTS=
ARG NEXT_PUBLIC_ADSENSE_SLOT_HISTORY=
ARG NEXT_PUBLIC_GA_MEASUREMENT_ID=
ARG NEXT_PUBLIC_ENABLE_LOCAL_NLP=false
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL
ENV INTERNAL_API_URL=$INTERNAL_API_URL
ENV NEXT_PUBLIC_ADSENSE_CLIENT=$NEXT_PUBLIC_ADSENSE_CLIENT
ENV NEXT_PUBLIC_ADSENSE_SLOT_TOOLS=$NEXT_PUBLIC_ADSENSE_SLOT_TOOLS
ENV NEXT_PUBLIC_ADSENSE_SLOT_DOCUMENTS=$NEXT_PUBLIC_ADSENSE_SLOT_DOCUMENTS
ENV NEXT_PUBLIC_ADSENSE_SLOT_HISTORY=$NEXT_PUBLIC_ADSENSE_SLOT_HISTORY
ENV NEXT_PUBLIC_GA_MEASUREMENT_ID=$NEXT_PUBLIC_GA_MEASUREMENT_ID
ENV NEXT_PUBLIC_ENABLE_LOCAL_NLP=$NEXT_PUBLIC_ENABLE_LOCAL_NLP
ENV NEXT_TELEMETRY_DISABLED=1

COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV INTERNAL_API_URL=http://backend:8000

COPY --from=builder /app/.next ./.next
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules

EXPOSE 3000

CMD ["npm", "run", "start"]
